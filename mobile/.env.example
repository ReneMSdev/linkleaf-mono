# Copy this file to .env.dev / .env.staging / .env.prod and fill in real values.
# These files are git-ignored — never commit them.
#
# Usage:
#   flutter run  --dart-define-from-file=.env.dev
#   flutter build apk --dart-define-from-file=.env.staging
#   flutter build ipa --dart-define-from-file=.env.prod
#
# Values are injected at compile time via String.fromEnvironment() in lib/core/env.dart.

ENV=dev
API_BASE_URL=http://localhost:8080
APP_NAME=LinkLeaf Dev
